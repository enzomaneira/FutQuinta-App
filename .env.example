# Copie para .env e ajuste. NUNCA commite o .env.

# Banco principal (dev local usa o Postgres do docker-compose)
DATABASE_URL=postgresql+psycopg://futquinta:futquinta@localhost:5432/futquinta

# Banco usado pelo pytest (criado automaticamente pelo docker-compose)
TEST_DATABASE_URL=postgresql+psycopg://futquinta:futquinta@localhost:5432/futquinta_test

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-valor-aleatorio-e-longo
JWT_EXPIRES_MINUTES=10080

# Fuso usado pelas rotinas agendadas e pelas regras de prazo
TZ=America/Sao_Paulo

# Desligue para rodar mais de um processo localmente sem duplicar rotinas
SCHEDULER_ENABLED=true
